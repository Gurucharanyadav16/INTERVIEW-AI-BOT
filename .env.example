# =============================================================================
# INTERVIEWFLOW AI — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and fill in verified credentials.
# By default, real external email sending and live Graph/Calendar mutations are
# disabled (SAFE_TEST_MODE=true) until credentials are configured and verified.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. REQUIRED FOR CORE MVP FUNCTIONALITY (Database & Authentication)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SIGNING_SECRET=

# Safe execution guards (Keep true until production credentials are verified)
SAFE_EMAIL_TEST_MODE=true
REQUIRE_ADMIN_EMAIL_APPROVAL=true

# -----------------------------------------------------------------------------
# 2. REQUIRED FOR AI FUNCTIONALITY (Anthropic Claude API)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_TASK_GEN=claude-3-5-sonnet-latest
ANTHROPIC_MODEL_CODE_REVIEW=claude-3-5-sonnet-latest

# -----------------------------------------------------------------------------
# 3. REQUIRED FOR GITHUB INTEGRATION (Least-Privilege GitHub App & Webhooks)
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 4. REQUIRED FOR GOOGLE WORKSPACE INTEGRATION (OAuth 2.0, Calendar, Meet, Gmail)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_CALENDAR_ID=primary
GMAIL_SENDER_ADDRESS=

# -----------------------------------------------------------------------------
# 5. REQUIRED FOR LIVE EXCEL SYNCHRONIZATION (Stage 2: Microsoft Graph API)
# Note: Stage 1 (CSV/XLSX local import & export) works without these variables.
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
EXCEL_WORKBOOK_ID=
EXCEL_DRIVE_ID=

# -----------------------------------------------------------------------------
# 6. BACKGROUND JOB PROCESSING (Inngest Durable Queue)
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# -----------------------------------------------------------------------------
# 7. OPTIONAL FOR FUTURE FUNCTIONALITY
# -----------------------------------------------------------------------------
SANDBOX_RUNNER_ENDPOINT=
ENABLE_VOICE_READ_ALOUD=true
AUDIT_RETENTION_DAYS=365
